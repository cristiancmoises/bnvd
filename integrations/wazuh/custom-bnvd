#!/usr/bin/env python3

import sys
import json
import requests
import socket

# Endereço do socket para o Wazuh 4.14.0
SOCKET_ADDR = '/var/ossec/queue/sockets/queue'

def send_to_wazuh(data):
    """Envia o JSON formatado para o Analysisd via socket UNIX"""
    try:
        msg = f"1:bnvd:{json.dumps(data)}"
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        sock.connect(SOCKET_ADDR)
        sock.send(msg.encode())
        sock.close()
    except Exception as e:
        with open('/tmp/bnvd_socket_error.log', 'a') as f:
            f.write(f"Erro ao conectar no socket {SOCKET_ADDR}: {str(e)}\n")

def get_severity(metrics):
    """Tenta extrair a severidade de múltiplas versões do CVSS"""
    # Ordem de preferência: 3.1 -> 3.0 -> 2.0
    for version in ["cvssMetricV31", "cvssMetricV30", "cvssMetricV2"]:
        v_data = metrics.get(version, [])
        if v_data and isinstance(v_data, list):
            # Tenta pegar baseSeverity (V3) ou simplesmente severity (V2)
            cvss_data = v_data[0].get("cvssData", {})
            sev = cvss_data.get("baseSeverity") or v_data[0].get("baseSeverity") or v_data[0].get("severity")
            if sev:
                return str(sev).upper()
    return "UNKNOWN"

def main():
    if len(sys.argv) < 2:
        return

    alert_file = sys.argv[1]

    try:
        with open(alert_file, 'r') as f:
            alert = json.load(f)

        cve_id = alert.get('data', {}).get('vulnerability', {}).get('id')
        if not cve_id:
            return

        api_url = f"https://bnvd.org/api/v1/vulnerabilities/{cve_id}"
        response = requests.get(api_url, timeout=15)

        if response.status_code == 200:
            raw_data = response.json()
            if raw_data.get("status") == "success":
                data_body = raw_data.get("data", {})
                
                metrics = data_body.get("cvss_metrics", {})
                severity = get_severity(metrics)

                payload = {
                    "integration": "bnvd",
                    "bnvd": {
                        "cve_id": cve_id,
                        "in_kev": str(data_body.get('in_kev', 'false')).lower(),
                        "cvss_severity": severity,
                        "description": data_body.get('descriptions_pt', [{}])[0].get('value', 'N/A'),
                        "source": "BNVD API"
                    }
                }
                send_to_wazuh(payload)
    except Exception as e:
        with open('/tmp/bnvd_script_error.log', 'a') as f:
            f.write(f"Erro geral no script: {str(e)}\n")

if __name__ == "__main__":
    main()
